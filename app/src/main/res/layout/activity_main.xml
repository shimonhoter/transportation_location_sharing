<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <WebView
        android:id="@+id/webViewMap"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/topButtonsRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:layout_marginEnd="@dimen/spacing_md"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnAlertZones"
            style="@style/Widget.MaterialComponents.FloatingActionButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:contentDescription="@string/alert_zones_menu_item"
            app:srcCompat="@android:drawable/ic_dialog_map"
            app:fabSize="mini" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnSettings"
            style="@style/Widget.MaterialComponents.FloatingActionButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:contentDescription="@string/settings_menu_item"
            app:srcCompat="@android:drawable/ic_menu_preferences"
            app:fabSize="mini" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnHelp"
            style="@style/Widget.MaterialComponents.FloatingActionButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/help_menu_item"
            app:srcCompat="@android:drawable/ic_dialog_info"
            app:fabSize="mini" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardEta"
        style="@style/RideCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:layout_marginEnd="@dimen/spacing_md"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/topButtonsRow"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvEta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_sm"
            android:textColor="@color/on_surface"
            android:textStyle="bold"
            android:textSize="@dimen/text_size_body" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/bottomButtonsRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_lg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSkipToday"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="@dimen/spacing_md"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="@string/skip_today_icon"
            android:textSize="22sp"
            app:cornerRadius="28dp"
            app:backgroundTint="@color/status_idle"
            android:contentDescription="@string/skip_today_label" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBroadcastToggle"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="@string/broadcast_toggle_icon_off"
            android:textSize="28sp"
            app:cornerRadius="36dp"
            app:backgroundTint="@color/status_idle"
            android:contentDescription="@string/broadcast_toggle_content_description" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrivateCar"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="@dimen/spacing_md"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="@string/private_car_icon"
            android:textSize="22sp"
            app:cornerRadius="28dp"
            app:backgroundTint="@color/status_idle"
            android:contentDescription="@string/private_car_content_description" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
